<Window x:Class="KFDEKC.Edit.Dialog.ContainerDVMCredentials"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:KFDEKC.Edit.Dialog"
        mc:Ignorable="d"
        Title="Enter DVM Credentials" Height="200" Width="350" WindowStartupLocation="CenterOwner" ResizeMode="NoResize">
    <Grid>
        <Label Content="DVM FNE IP" HorizontalAlignment="Left" Margin="10,10,0,0" VerticalAlignment="Top"/>
        <TextBox Name="txtDVMFNEIP" HorizontalAlignment="Left" Margin="93,15,0,0" VerticalAlignment="Top" Width="232"/>
        <Label Content="DVM Peer ID" HorizontalAlignment="Left" Margin="10,41,0,0" VerticalAlignment="Top"/>
        <TextBox x:Name="txtDVMPeerID" HorizontalAlignment="Left" Margin="93,45,0,0" VerticalAlignment="Top" Width="232"/>
        <Label Content="DVM Peer Password" HorizontalAlignment="Left" Margin="10,72,0,0" VerticalAlignment="Top" Width="118"/>
        <PasswordBox x:Name="txtDVMPeerPassword" HorizontalAlignment="Left" Margin="157,76,0,0" VerticalAlignment="Top" Width="168"/>
        <Label Content="Remote Access Password" HorizontalAlignment="Left" Margin="10,103,0,0" VerticalAlignment="Top"/>
        <PasswordBox x:Name="txtDVMRemoteAccessPassword" HorizontalAlignment="Left" Margin="157,107,0,0" VerticalAlignment="Top" Width="168"/>
        <Button Content="Submit" Click="Submit_Click" IsDefault="True" HorizontalAlignment="Left" Margin="13,134,0,0" VerticalAlignment="Top" Width="75"/>
    </Grid>
</Window>
