<UserControl x:Class="KFDEKC.Edit.Control.ContainerViewKeyInfo"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:KFDEKC.Edit.Control"
             xmlns:res="clr-namespace:KFDtool.Gui.Converters"
             mc:Ignorable="d" 
             Height="400" Width="800">
    <UserControl.Resources>
        <res:AlgorithmFormatConverter x:Key="algorithmFormatConverter" />
    </UserControl.Resources>
    <Grid>
        <TextBlock Name="KeyCount" Margin="38,14,38,361"></TextBlock>
        <DataGrid Name="KeyItems" AutoGenerateColumns="False" IsReadOnly="True" HorizontalAlignment="Center" Height="351" VerticalAlignment="Top" Width="724" Margin="0,39,0,0">
            <DataGrid.Columns>
                <DataGridTextColumn Binding="{Binding Path=Name}" Header="Name" />
                <DataGridTextColumn Binding="{Binding Path=Sln, StringFormat={}{0} (0x{0:X})}" Header="SLN" />
                <DataGridTextColumn Binding="{Binding Path=KeyId, StringFormat={}{0} (0x{0:X})}" Header="Key ID" />
                <DataGridTextColumn Binding="{Binding Path=AlgorithmId, Converter={StaticResource algorithmFormatConverter}}" Header="Algorithm" />
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</UserControl>
